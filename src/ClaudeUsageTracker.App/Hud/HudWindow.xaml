<!--
  The activity HUD: upstream's notch HUD (NotchCompactViews, NotchExpandedView) as a floating pill at the top
  centre of the primary display, since a Windows PC has no notch. A click switches between the compact pill
  and the session list. It only shows what Claude Code reports; nothing in it answers or controls a session.
-->
<Window x:Class="ClaudeUsageTracker.App.Hud.HudWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:ClaudeUsageTracker.App.Localisation"
        xmlns:views="clr-namespace:ClaudeUsageTracker.App.Views"
        Title="{l:Loc windows.hud.accessible}"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize"
        ShowInTaskbar="False" ShowActivated="False" Topmost="True" Focusable="False" SizeToContent="WidthAndHeight"
        FontFamily="{StaticResource UiFont}" UseLayoutRounding="True" SnapsToDevicePixels="True"
        AutomationProperties.Name="{l:Loc windows.hud.accessible}">
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="Visible" />
    <SolidColorBrush x:Key="Hud.Text" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Hud.Text.Soft" Color="#A6FFFFFF" />
    <SolidColorBrush x:Key="Hud.Text.Faint" Color="#73FFFFFF" />
  </Window.Resources>
  <!-- A button, so that assistive tools can press it; it never takes the keyboard focus. -->
  <Button Click="OnToggle" Focusable="False" Cursor="Hand" AutomationProperties.Name="{l:Loc windows.hud.accessible}">
    <Button.Template>
      <ControlTemplate TargetType="Button">
        <Border Background="#F0000000" BorderBrush="#33FFFFFF" BorderThickness="1" CornerRadius="14">
          <ContentPresenter />
        </Border>
      </ControlTemplate>
    </Button.Template>
    <Grid>
      <!-- Compact: status symbol and project on the left, status and session count on the right. -->
      <StackPanel Orientation="Horizontal" Margin="14,7" DataContext="{Binding Primary}"
                  Visibility="{Binding DataContext.IsCompact, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource Visible}}">
        <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource IconFont}" FontSize="12" VerticalAlignment="Center"
                   Foreground="{Binding Colour}" />
        <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="Medium" Foreground="{StaticResource Hud.Text}" Margin="7,0,0,0"
                   MaxWidth="150" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
        <TextBlock Text="{Binding StatusText}" FontSize="12" Foreground="{StaticResource Hud.Text.Soft}" Margin="12,0,0,0"
                   VerticalAlignment="Center" />
        <Border Background="#26FFFFFF" CornerRadius="7" Padding="5,1" Margin="7,0,0,0" VerticalAlignment="Center"
                Visibility="{Binding DataContext.HasSeveral, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource Visible}}">
          <TextBlock Text="{Binding DataContext.CountText, RelativeSource={RelativeSource AncestorType=Window}}" FontSize="10" FontWeight="SemiBold"
                     Foreground="{StaticResource Hud.Text}" />
        </Border>
        <TextBlock Text="{Binding DataContext.FixtureLabel, RelativeSource={RelativeSource AncestorType=Window}}" FontSize="10"
                   Foreground="#FFD60A" Margin="10,0,0,0" VerticalAlignment="Center"
                   Visibility="{Binding DataContext.FixtureLabel, RelativeSource={RelativeSource AncestorType=Window}, Converter={x:Static views:Converters.NotNullToVisible}}" />
      </StackPanel>

      <!-- Expanded: every live session with its status, current task or last prompt, and elapsed time. -->
      <StackPanel Width="300" Margin="12" Visibility="{Binding IsExpanded, Converter={StaticResource Visible}}">
        <DockPanel Margin="0,0,0,8">
          <TextBlock DockPanel.Dock="Right" Text="{Binding Count}" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource Hud.Text.Soft}"
                     Visibility="{Binding HasSeveral, Converter={StaticResource Visible}}" />
          <TextBlock Text="&#xE945;" FontFamily="{StaticResource IconFont}" FontSize="10" Foreground="{StaticResource Hud.Text.Soft}"
                     VerticalAlignment="Center" />
          <TextBlock Text="{l:Loc notch.hud.expanded_title}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Hud.Text}"
                     Margin="6,0,0,0" />
          <TextBlock Text="{Binding FixtureLabel}" FontSize="10" Foreground="#FFD60A" Margin="10,0,0,0" VerticalAlignment="Center"
                     Visibility="{Binding FixtureLabel, Converter={x:Static views:Converters.NotNullToVisible}}" />
        </DockPanel>
        <ItemsControl ItemsSource="{Binding Rows}" Focusable="False">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Grid Margin="0,3" AutomationProperties.Name="{Binding AccessibleName}">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="24" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource IconFont}" FontSize="13" Foreground="{Binding Colour}"
                           VerticalAlignment="Center" />
                <StackPanel Grid.Column="1">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding Name}" FontSize="11.5" FontWeight="Medium" Foreground="{StaticResource Hud.Text}"
                               MaxWidth="190" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="&#xE783;" FontFamily="{StaticResource IconFont}" FontSize="9" Foreground="#FF453A" Margin="5,0,0,0"
                               VerticalAlignment="Center" Visibility="{Binding HasError, Converter={StaticResource Visible}}" />
                  </StackPanel>
                  <TextBlock Text="{Binding Secondary}" FontSize="10" Foreground="{StaticResource Hud.Text.Soft}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <TextBlock Grid.Column="2" Text="{Binding Elapsed}" FontFamily="{StaticResource MonoFont}" FontSize="10"
                           Foreground="{StaticResource Hud.Text.Faint}" VerticalAlignment="Center" Margin="8,0,0,0" />
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </Grid>
  </Button>
</Window>
