<!--
  Upstream SetupWizardView for the Claude Code route, 580 x 680 DIP content. Each step is a panel shown by
  the code-behind. Upstream's logo artwork is not reused (its use could imply an endorsement); a neutral
  ring mark stands in.
-->
<Window x:Class="ClaudeUsageTracker.App.Setup.SetupWizardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:ClaudeUsageTracker.App.Localisation"
        Title="{l:Loc windows.setup.window_title}"
        SizeToContent="WidthAndHeight" ResizeMode="CanMinimize" WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Window.Background}" FontFamily="{StaticResource UiFont}"
        UseLayoutRounding="True">
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="Visible" />
    <Style x:Key="StepCircle" TargetType="Border">
      <Setter Property="Width" Value="24" />
      <Setter Property="Height" Value="24" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Background" Value="{DynamicResource Track}" />
    </Style>
    <Style x:Key="StepNumber" TargetType="TextBlock" BasedOn="{StaticResource Text.Secondary}">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="LinkButton" TargetType="Button" BasedOn="{StaticResource PlainButton}">
      <Setter Property="Padding" Value="4,2" />
      <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>
  </Window.Resources>

  <Grid Width="580" Height="680">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- Header: mark, welcome title, subtitle, step indicator. -->
    <StackPanel Margin="32,32,32,16">
      <StackPanel Orientation="Horizontal">
        <Grid Width="64" Height="64" Margin="0,0,14,0">
          <Ellipse Stroke="{DynamicResource Accent}" StrokeThickness="6" />
          <Ellipse Width="14" Height="14" Fill="{DynamicResource Accent}" />
        </Grid>
        <StackPanel VerticalAlignment="Center">
          <TextBlock Style="{StaticResource Text.Base}" Text="{l:Loc setup.welcome.title}" FontSize="24" FontWeight="SemiBold" />
          <TextBlock x:Name="Subtitle" Style="{StaticResource Text.Secondary}" FontSize="13" Margin="0,8,0,0" TextWrapping="Wrap" MaxWidth="420" />
        </StackPanel>
      </StackPanel>
      <StackPanel x:Name="Progress" Orientation="Horizontal" Margin="0,20,0,0">
        <Border x:Name="Step1" Style="{StaticResource StepCircle}"><TextBlock x:Name="Step1Text" Style="{StaticResource StepNumber}" Text="1" /></Border>
        <Rectangle x:Name="Line1" Width="40" Height="2" Margin="8,0" Fill="{DynamicResource Track}" />
        <Border x:Name="Step2" Style="{StaticResource StepCircle}"><TextBlock x:Name="Step2Text" Style="{StaticResource StepNumber}" Text="2" /></Border>
        <Rectangle x:Name="Line2" Width="40" Height="2" Margin="8,0" Fill="{DynamicResource Track}" />
        <Border x:Name="Step3" Style="{StaticResource StepCircle}"><TextBlock x:Name="Step3Text" Style="{StaticResource StepNumber}" Text="3" /></Border>
      </StackPanel>
    </StackPanel>

    <Grid Grid.Row="1" Margin="32,0,32,28">
      <!-- Provider choice -->
      <StackPanel x:Name="ChoosePanel" VerticalAlignment="Center">
        <TextBlock Style="{StaticResource Text.Secondary}" Text="{l:Loc setup.choose_provider.subtitle}" FontSize="13" HorizontalAlignment="Center" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,24,0,0">
          <Button x:Name="AnthropicCard" Style="{StaticResource PlainButton}" Width="180" Margin="0,0,16,0" Click="OnAnthropic"
                  HorizontalContentAlignment="Stretch" AutomationProperties.Name="Anthropic">
            <Border Background="{DynamicResource Card.Background}" BorderBrush="{DynamicResource Card.Border}" BorderThickness="1"
                    CornerRadius="10" Padding="12,24">
              <StackPanel>
                <TextBlock Style="{StaticResource Text.Icon}" Text="&#xE756;" FontSize="30" HorizontalAlignment="Center" Foreground="{DynamicResource Accent}" />
                <TextBlock Style="{StaticResource Text.Base}" Text="Anthropic" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,12,0,0" />
                <TextBlock Style="{StaticResource Text.Caption}" Text="{l:Loc setup.choose_provider.anthropic_hint}" TextAlignment="Center" Margin="0,6,0,0" />
              </StackPanel>
            </Border>
          </Button>
          <Border Width="180" Background="{DynamicResource Card.Background}" BorderBrush="{DynamicResource Card.Border}" BorderThickness="1"
                  CornerRadius="10" Padding="12,24" Opacity="0.55" AutomationProperties.Name="OpenAI Codex"
                  AutomationProperties.HelpText="{l:Loc windows.setup.codex_later}">
            <StackPanel>
              <TextBlock Style="{StaticResource Text.Icon}" Text="&#xE943;" FontSize="30" HorizontalAlignment="Center" />
              <TextBlock Style="{StaticResource Text.Base}" Text="OpenAI Codex" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,12,0,0" />
              <TextBlock Style="{StaticResource Text.Caption}" Text="{l:Loc setup.choose_provider.codex_hint}" TextAlignment="Center" Margin="0,6,0,0" />
              <TextBlock Style="{StaticResource Text.Caption}" Text="{l:Loc windows.setup.codex_later}" TextAlignment="Center" FontWeight="SemiBold" Margin="0,8,0,0" />
            </StackPanel>
          </Border>
        </StackPanel>
        <Button Style="{StaticResource LinkButton}" Margin="0,24,0,0" Click="OnClose" AutomationProperties.Name="{l:Loc setup.choose_provider.skip}">
          <TextBlock Style="{StaticResource Text.Secondary}" Text="{l:Loc setup.choose_provider.skip}" FontSize="12" />
        </Button>
      </StackPanel>

      <!-- Detecting / testing / saving -->
      <StackPanel x:Name="BusyPanel" VerticalAlignment="Center">
        <ProgressBar IsIndeterminate="True" Width="160" Height="4" Foreground="{DynamicResource Accent}" Background="{DynamicResource Track}" BorderThickness="0" />
        <TextBlock x:Name="BusyText" Style="{StaticResource Text.Secondary}" FontSize="13" HorizontalAlignment="Center" Margin="0,16,0,0" />
      </StackPanel>

      <!-- Detected -->
      <DockPanel x:Name="DetectedPanel">
        <StackPanel DockPanel.Dock="Bottom">
          <TextBlock Style="{StaticResource Text.Caption}" Text="{l:Loc windows.setup.later_routes}" TextAlignment="Center" Margin="0,12,0,0" />
        </StackPanel>
        <StackPanel VerticalAlignment="Center">
          <Border Width="72" Height="72" CornerRadius="36" Background="{DynamicResource Banner.Info}" HorizontalAlignment="Center">
            <TextBlock Style="{StaticResource Text.Icon}" Text="&#xE756;" FontSize="30" Foreground="{DynamicResource Status.Safe}" HorizontalAlignment="Center" />
          </Border>
          <TextBlock Style="{StaticResource Text.Base}" Text="{l:Loc setup.cli_detected.title}" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,16,0,0" />
          <TextBlock Style="{StaticResource Text.Secondary}" Text="{l:Loc setup.cli_detected.description}" FontSize="14" TextWrapping="Wrap"
                     TextAlignment="Center" Margin="40,8,40,0" />
          <ItemsControl x:Name="CandidateList" Margin="0,16,0,0" ItemsSource="{Binding Candidates}" Focusable="False">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <RadioButton GroupName="Candidates" IsEnabled="{Binding Usable}" Margin="0,3" Checked="OnCandidateChecked"
                             Tag="{Binding}" FocusVisualStyle="{StaticResource FocusRing}" AutomationProperties.Name="{Binding Label}">
                  <RadioButton.Template>
                    <ControlTemplate TargetType="RadioButton">
                      <Border x:Name="Chrome" Background="{DynamicResource Card.Background}" BorderBrush="{DynamicResource Card.Border}"
                              BorderThickness="1" CornerRadius="8" Padding="12,8" ToolTip="{Binding Detail}">
                        <StackPanel>
                          <TextBlock Style="{StaticResource Text.Base}" Text="{Binding Label}" FontSize="13" FontWeight="Medium" TextTrimming="CharacterEllipsis" />
                          <TextBlock Style="{StaticResource Text.Caption}" Text="{Binding Detail}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                        </StackPanel>
                      </Border>
                      <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                          <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Accent}" />
                          <Setter TargetName="Chrome" Property="BorderThickness" Value="2" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                          <Setter TargetName="Chrome" Property="Opacity" Value="0.55" />
                        </Trigger>
                      </ControlTemplate.Triggers>
                    </ControlTemplate>
                  </RadioButton.Template>
                </RadioButton>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <Button Style="{StaticResource PrimaryButton}" Padding="28,10" FontSize="14" Margin="0,20,0,0" HorizontalAlignment="Center"
                  Click="OnStartTracking" AutomationProperties.Name="{l:Loc setup.cli_detected.start}">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#xE9D2;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center" Margin="0,0,8,0" />
              <TextBlock Text="{l:Loc setup.cli_detected.start}" />
            </StackPanel>
          </Button>
          <TextBlock Style="{StaticResource Text.Caption}" Text="{l:Loc windows.setup.test.description}" TextAlignment="Center" Margin="0,10,0,0" />
          <Button Style="{StaticResource LinkButton}" Margin="0,10,0,0" Click="OnChooseFolder" AutomationProperties.Name="{l:Loc windows.setup.choose_folder}">
            <TextBlock Style="{StaticResource Text.Secondary}" Text="{l:Loc windows.setup.choose_folder}" FontSize="12" />
          </Button>
        </StackPanel>
      </DockPanel>

      <!-- Not found -->
      <StackPanel x:Name="NotFoundPanel" VerticalAlignment="Center">
        <TextBlock Style="{StaticResource Text.Base}" Text="{l:Loc windows.setup.not_found.title}" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" />
        <Border Background="{DynamicResource Banner.Warning}" CornerRadius="6" Padding="12,10" Margin="0,16,0,0">
          <TextBlock Style="{StaticResource Text.Body}" Text="{Binding Message}" />
        </Border>
        <ItemsControl ItemsSource="{Binding Candidates}" Margin="0,12,0,0" Focusable="False">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <TextBlock Style="{StaticResource Text.Caption}" Text="{Binding Detail}" Margin="0,2" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
          <Button Style="{StaticResource PrimaryButton}" Content="{l:Loc windows.setup.check_again}" Click="OnCheckAgain" Margin="0,0,10,0" />
          <Button Style="{StaticResource SecondaryButton}" Content="{l:Loc windows.setup.choose_folder}" Click="OnChooseFolder" Margin="0,0,10,0" />
          <Button Style="{StaticResource SecondaryButton}" Content="{l:Loc common.close}" Click="OnClose" />
        </StackPanel>
      </StackPanel>

      <!-- Test failed -->
      <StackPanel x:Name="FailedPanel" VerticalAlignment="Center">
        <TextBlock Style="{StaticResource Text.Base}" Text="{l:Loc windows.setup.test.failed_title}" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" />
        <Border Background="{DynamicResource Banner.Warning}" CornerRadius="6" Padding="12,10" Margin="0,16,0,0">
          <StackPanel Orientation="Horizontal">
            <TextBlock Style="{StaticResource Text.Icon}" Text="&#xEA39;" FontSize="12" Foreground="{DynamicResource Status.Critical}" VerticalAlignment="Top" Margin="0,2,8,0" />
            <TextBlock Style="{StaticResource Text.Body}" Text="{Binding Message}" MaxWidth="460" />
          </StackPanel>
        </Border>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
          <Button Style="{StaticResource SecondaryButton}" Content="{l:Loc common.back}" Click="OnBack" Margin="0,0,10,0" />
          <Button Style="{StaticResource PrimaryButton}" Content="{l:Loc common.retry}" Click="OnStartTracking" />
        </StackPanel>
      </StackPanel>

      <!-- Review -->
      <DockPanel x:Name="ReviewPanel">
        <Grid DockPanel.Dock="Bottom" Margin="0,16,0,0">
          <Button Style="{StaticResource SecondaryButton}" Content="{l:Loc common.back}" HorizontalAlignment="Left" Click="OnBack" />
          <Button Style="{StaticResource PrimaryButton}" Content="{l:Loc common.done}" Width="100" HorizontalAlignment="Right" Click="OnSave" />
        </Grid>
        <StackPanel>
          <StackPanel Orientation="Horizontal">
            <Border Width="28" Height="28" CornerRadius="14" Background="{DynamicResource Accent}">
              <TextBlock Text="3" Foreground="White" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <TextBlock Style="{StaticResource Text.Base}" Text="{l:Loc wizard.review_config}" FontSize="16" FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center" />
          </StackPanel>
          <Border Style="{StaticResource Card}" Margin="0,20,0,0">
            <StackPanel>
              <TextBlock Style="{StaticResource Text.Base}" Text="{l:Loc wizard.config_summary}" FontSize="14" FontWeight="SemiBold" />
              <ItemsControl ItemsSource="{Binding Review}" Margin="0,8,0,0" Focusable="False">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <StackPanel Margin="0,8,0,0">
                      <TextBlock Style="{StaticResource Text.Secondary}" Text="{Binding Label}" FontSize="12" FontWeight="Medium" />
                      <TextBlock Style="{StaticResource Text.Base}" Text="{Binding Value}" FontSize="13" Margin="0,3,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>
          <Border Background="{DynamicResource Banner.Warning}" CornerRadius="6" Padding="12,8" Margin="0,12,0,0"
                  Visibility="{Binding ReviewWarning, Converter={x:Static views:Converters.NotNullToVisible}}"
                  xmlns:views="clr-namespace:ClaudeUsageTracker.App.Views">
            <TextBlock Style="{StaticResource Text.Body}" Text="{Binding ReviewWarning}" />
          </Border>
          <Border x:Name="SaveError" Background="{DynamicResource Banner.Warning}" CornerRadius="6" Padding="12,8" Margin="0,12,0,0">
            <TextBlock Style="{StaticResource Text.Body}" Text="{Binding Message}" Foreground="{DynamicResource Status.Critical}" />
          </Border>
        </StackPanel>
      </DockPanel>
    </Grid>
  </Grid>
</Window>
