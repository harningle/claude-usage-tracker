<!--
  The tray popover: upstream PopoverContentView (SmartHeader, banner, SmartUsageDashboard) at 280 DIP.
  Upstream's profile switcher menu appears with profile management in Milestone 3; with one profile it
  would have nothing to switch to.
-->
<Window x:Class="ClaudeUsageTracker.App.Views.PopoverWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:ClaudeUsageTracker.App.Views"
        xmlns:l="clr-namespace:ClaudeUsageTracker.App.Localisation"
        Title="{l:Loc app.name}"
        Width="280" SizeToContent="Height"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        Background="{DynamicResource Popover.Background}"
        BorderBrush="{DynamicResource Popover.Border}" BorderThickness="1"
        FontFamily="{StaticResource UiFont}"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        AutomationProperties.Name="{l:Loc app.name}">
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="Visible" />
  </Window.Resources>

  <StackPanel Margin="0,0,0,8">
    <!-- Header: profile name and service status, refresh and settings. Dragging it detaches the popover. -->
    <Grid x:Name="Header" Margin="14,10" Background="Transparent" MouseLeftButtonDown="OnHeaderMouseDown">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <StackPanel VerticalAlignment="Center">
        <StackPanel Orientation="Horizontal">
          <TextBlock Style="{StaticResource Text.Base}" Text="{Binding ProfileName}" FontSize="13" FontWeight="Bold"
                     TextTrimming="CharacterEllipsis" MaxWidth="150" />
          <Border Background="{DynamicResource Accent.Soft}" CornerRadius="7" Padding="5,1" Margin="6,0,0,0" VerticalAlignment="Center"
                  Visibility="{Binding FixtureLabel, Converter={x:Static views:Converters.NotNullToVisible}}">
            <TextBlock Style="{StaticResource Text.Base}" Text="{Binding FixtureLabel}" FontSize="9" FontWeight="SemiBold"
                       Foreground="{DynamicResource Accent}" />
          </Border>
        </StackPanel>
        <Button Style="{StaticResource PlainButton}" Margin="0,2,0,0" Click="OnStatusClick" ToolTip="{Binding StatusTooltip}"
                AutomationProperties.Name="{Binding StatusText}" AutomationProperties.HelpText="{Binding StatusTooltip}">
          <StackPanel Orientation="Horizontal">
            <Ellipse Width="6" Height="6" Fill="{Binding StatusBrush}" VerticalAlignment="Center" />
            <TextBlock Style="{StaticResource Text.Secondary}" Text="{Binding StatusText}" FontSize="9" FontWeight="Medium"
                       Margin="4,0,0,0" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
        <Button x:Name="RefreshButton" Style="{StaticResource HeaderIconButton}" Click="OnRefreshClick"
                ToolTip="{Binding RefreshLabel}" AutomationProperties.Name="{Binding RefreshLabel}">
          <TextBlock x:Name="RefreshGlyph" Text="&#xE72C;" FontFamily="{StaticResource IconFont}" FontSize="11"
                     Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                     RenderTransformOrigin="0.5,0.5">
            <TextBlock.RenderTransform>
              <RotateTransform x:Name="RefreshRotation" />
            </TextBlock.RenderTransform>
          </TextBlock>
        </Button>
        <Button Style="{StaticResource HeaderIconButton}" Margin="2,0,0,0" Click="OnSettingsClick"
                ToolTip="{Binding SettingsLabel}" AutomationProperties.Name="{Binding SettingsLabel}">
          <TextBlock Text="&#xE713;" FontFamily="{StaticResource IconFont}" FontSize="12"
                     Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
        </Button>
      </StackPanel>
    </Grid>

    <Rectangle Height="1" Margin="16,0" Fill="{DynamicResource Line.Divider}" />

    <!-- At most one banner, upstream StatusBannerView. -->
    <Button x:Name="BannerButton" Style="{StaticResource PlainButton}" Margin="10,4,10,0" Click="OnBannerClick"
            DataContext="{Binding Banner}" AutomationProperties.Name="{Binding Message}"
            IsTabStop="{Binding HasAction}" HorizontalContentAlignment="Stretch">
      <Button.Visibility>
        <Binding Path="." Converter="{x:Static views:Converters.NotNullToVisible}" />
      </Button.Visibility>
      <Border Background="{Binding Background}" CornerRadius="6" Padding="14,6">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock Style="{StaticResource Text.Icon}" Text="{Binding Glyph}" FontSize="11" Foreground="{Binding GlyphBrush}" />
          <TextBlock Grid.Column="1" Style="{StaticResource Text.Base}" Text="{Binding Message}" FontSize="11" FontWeight="Medium"
                     Margin="8,0" TextWrapping="Wrap" VerticalAlignment="Center" />
          <TextBlock Grid.Column="2" Style="{StaticResource Text.Icon}" Text="&#xE76C;" FontSize="9"
                     Visibility="{Binding HasAction, Converter={StaticResource Visible}}" />
        </Grid>
      </Border>
    </Button>

    <TextBlock Style="{StaticResource Text.Secondary}" Text="{Binding Placeholder}" FontSize="12" Margin="14,16,14,10"
               TextWrapping="Wrap" HorizontalAlignment="Center" TextAlignment="Center"
               Visibility="{Binding Placeholder, Converter={x:Static views:Converters.NotNullToVisible}}" />

    <!-- Upstream SmartUsageDashboard: cards 252 DIP wide, 6 DIP apart. -->
    <ItemsControl ItemsSource="{Binding Rows}" Margin="14,8,14,0" Focusable="False">
      <ItemsControl.ItemTemplate>
        <DataTemplate>
          <Border BorderBrush="{DynamicResource Card.Border}" BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,0,0,6"
                  AutomationProperties.Name="{Binding AccessibleName}" Focusable="False">
            <StackPanel>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Text.Base}" Text="{Binding Title}" FontSize="13" FontWeight="Medium" />
                    <Border Background="{DynamicResource Tag.Background}" CornerRadius="7" Padding="5,1" Margin="5,0,0,0"
                            VerticalAlignment="Center" Visibility="{Binding HasTag, Converter={StaticResource Visible}}">
                      <TextBlock Style="{StaticResource Text.Secondary}" Text="{Binding Tag}" FontSize="9" FontWeight="Medium" />
                    </Border>
                  </StackPanel>
                  <TextBlock Style="{StaticResource Text.Secondary}" Text="{Binding Subtitle}" FontSize="10" Margin="0,1,0,0"
                             Visibility="{Binding HasSubtitle, Converter={StaticResource Visible}}" />
                </StackPanel>
                <TextBlock Grid.Column="1" Style="{StaticResource Text.Base}" Text="{Binding PercentText}" FontSize="13"
                           FontWeight="SemiBold" Foreground="{Binding PercentBrush}" VerticalAlignment="Top" />
              </Grid>
              <views:UsageBar Margin="0,5,0,0" Fraction="{Binding BarFraction}" Marker="{Binding Marker}"
                              Fill="{Binding FillBrush}" MarkerBrush="{Binding MarkerBrush}" Track="{DynamicResource Track}" />
              <TextBlock Style="{StaticResource Text.Secondary}" Text="{Binding ResetText}" FontSize="9" Margin="0,5,0,0"
                         Visibility="{Binding HasReset, Converter={StaticResource Visible}}" />
            </StackPanel>
          </Border>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
  </StackPanel>
</Window>
