<!--
  Upstream SettingsView: 720 x 750 DIP, a 190 DIP sidebar and one page per section. Only sections whose
  features exist in Milestone 2 are listed; later ones appear with their features, not as placeholders.
  Standard Windows chrome replaces upstream's borderless window and traffic-light buttons.
-->
<Window x:Class="ClaudeUsageTracker.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:ClaudeUsageTracker.App.Localisation"
        xmlns:views="clr-namespace:ClaudeUsageTracker.App.Views"
        Title="{l:Loc app.window.settings}"
        Width="720" Height="750" MinHeight="480" ResizeMode="CanResize" WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Window.Background}" FontFamily="{StaticResource UiFont}" UseLayoutRounding="True">
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="Visible" />
    <Style x:Key="Caption" TargetType="TextBlock" BasedOn="{StaticResource Text.Secondary}">
      <Setter Property="FontSize" Value="9" />
      <Setter Property="FontWeight" Value="Medium" />
      <Setter Property="Margin" Value="12,10,8,4" />
    </Style>
    <Style x:Key="ToggleRow" TargetType="Grid">
      <Setter Property="Margin" Value="0,0,0,16" />
    </Style>
    <DataTemplate x:Key="StyleOption">
      <StackPanel Margin="2,4">
        <Image Source="{Binding Preview}" Width="32" Height="32" Margin="0,8" />
        <TextBlock Text="{Binding Name}" FontSize="9" FontWeight="Medium" TextAlignment="Center" TextWrapping="Wrap" />
      </StackPanel>
    </DataTemplate>
    <Style x:Key="StylePicker" TargetType="ListBox">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Foreground" Value="{DynamicResource Foreground.Primary}" />
      <Setter Property="ItemTemplate" Value="{StaticResource StyleOption}" />
      <Setter Property="ItemsPanel">
        <Setter.Value>
          <ItemsPanelTemplate><UniformGrid Columns="5" /></ItemsPanelTemplate>
        </Setter.Value>
      </Setter>
      <Setter Property="ItemContainerStyle">
        <Setter.Value>
          <Style TargetType="ListBoxItem">
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
            <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
            <Setter Property="Template">
              <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                  <Border x:Name="Chrome" CornerRadius="6" BorderThickness="1" BorderBrush="{DynamicResource Card.Border}" Background="Transparent">
                    <ContentPresenter />
                  </Border>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsSelected" Value="True">
                      <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Status.Safe}" />
                      <Setter TargetName="Chrome" Property="BorderThickness" Value="2" />
                    </Trigger>
                    <Trigger Property="IsMouseOver" Value="True">
                      <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Hover}" />
                    </Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </Setter.Value>
            </Setter>
          </Style>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="190" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <!-- Sidebar -->
    <DockPanel Background="{DynamicResource Sidebar.Background}">
      <StackPanel DockPanel.Dock="Bottom" Margin="8,0,8,8">
        <TextBlock Style="{StaticResource Caption}" Text="{l:Loc section.app}" />
        <RadioButton x:Name="NavPopover" Style="{StaticResource SidebarItem}" GroupName="Nav" Checked="OnNavigate"
                     AutomationProperties.Name="{l:Loc section.popover_title}">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="&#xE737;" FontFamily="{StaticResource IconFont}" FontSize="11" Width="18" VerticalAlignment="Center" />
            <TextBlock Text="{l:Loc section.popover_title}" />
          </StackPanel>
        </RadioButton>
        <Rectangle Height="1" Margin="4,8" Fill="{DynamicResource Line.Divider}" />
        <UniformGrid Columns="2">
          <RadioButton x:Name="NavAbout" Style="{StaticResource SidebarItem}" GroupName="Nav" Checked="OnNavigate"
                       ToolTip="{l:Loc settings.about}" AutomationProperties.Name="{l:Loc settings.about}">
            <StackPanel>
              <TextBlock Text="&#xE946;" FontFamily="{StaticResource IconFont}" FontSize="12" HorizontalAlignment="Center" />
              <TextBlock Text="{l:Loc settings.about}" FontSize="9" FontWeight="Medium" HorizontalAlignment="Center" Margin="0,2,0,0" />
            </StackPanel>
          </RadioButton>
          <Button Style="{StaticResource PlainButton}" Margin="4,1" Padding="8,5" Click="OnQuit" HorizontalContentAlignment="Center"
                  ToolTip="{l:Loc common.quit}" AutomationProperties.Name="{l:Loc common.quit}">
            <StackPanel>
              <TextBlock Text="&#xE7E8;" FontFamily="{StaticResource IconFont}" FontSize="12" HorizontalAlignment="Center"
                         Foreground="{DynamicResource Foreground.Primary}" />
              <TextBlock Text="{l:Loc common.quit}" FontSize="9" FontWeight="Medium" HorizontalAlignment="Center" Margin="0,2,0,0"
                         Foreground="{DynamicResource Foreground.Primary}" />
            </StackPanel>
          </Button>
        </UniformGrid>
      </StackPanel>

      <StackPanel Margin="8,12,8,0">
        <Border Background="{DynamicResource Card.Background}" BorderBrush="{DynamicResource Card.Border}" BorderThickness="1" CornerRadius="6" Padding="0,0,0,6">
          <StackPanel>
            <TextBlock Style="{StaticResource Caption}" Text="{l:Loc section.active_profile}" Margin="10,8,8,2" />
            <TextBlock Style="{StaticResource Text.Base}" Text="{Binding ProfileName}" FontSize="12" FontWeight="SemiBold" Margin="10,0,8,4"
                       TextTrimming="CharacterEllipsis" />
            <Rectangle Height="1" Margin="8,4" Fill="{DynamicResource Line.Divider}" />
            <TextBlock Style="{StaticResource Caption}" Text="{l:Loc section.credentials}" Margin="10,4,8,2" />
            <RadioButton x:Name="NavCli" Style="{StaticResource SidebarItem}" GroupName="Nav" Checked="OnNavigate"
                         AutomationProperties.Name="{l:Loc section.cli_account_title}">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="&#xE756;" FontFamily="{StaticResource IconFont}" FontSize="11" Width="18" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="{l:Loc section.cli_account_title}" />
                <Ellipse Grid.Column="2" Width="5" Height="5" VerticalAlignment="Center"
                         Fill="{DynamicResource Status.Safe}" Visibility="{Binding IsLinked, Converter={StaticResource Visible}}" />
              </Grid>
            </RadioButton>
            <Rectangle Height="1" Margin="8,6" Fill="{DynamicResource Line.Divider}" />
            <TextBlock Style="{StaticResource Caption}" Text="{l:Loc section.settings}" Margin="10,2,8,2" />
            <RadioButton x:Name="NavAppearance" Style="{StaticResource SidebarItem}" GroupName="Nav" Checked="OnNavigate"
                         AutomationProperties.Name="{l:Loc settings.appearance}">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE790;" FontFamily="{StaticResource IconFont}" FontSize="11" Width="18" VerticalAlignment="Center" />
                <TextBlock Text="{l:Loc settings.appearance}" />
              </StackPanel>
            </RadioButton>
            <RadioButton x:Name="NavGeneral" Style="{StaticResource SidebarItem}" GroupName="Nav" Checked="OnNavigate"
                         AutomationProperties.Name="{l:Loc settings.general}">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE713;" FontFamily="{StaticResource IconFont}" FontSize="11" Width="18" VerticalAlignment="Center" />
                <TextBlock Text="{l:Loc settings.general}" />
              </StackPanel>
            </RadioButton>
          </StackPanel>
        </Border>
      </StackPanel>
    </DockPanel>

    <!-- Pages -->
    <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Focusable="False">
      <Grid Margin="20">
        <!-- CLI Account -->
        <StackPanel x:Name="PageCli">
          <TextBlock Style="{StaticResource Text.PageTitle}" Text="{l:Loc cli.title}" />
          <TextBlock Style="{StaticResource Text.PageSubtitle}" Text="{l:Loc cli.subtitle}" />
          <Border Style="{StaticResource Card}" Margin="0,24,0,0">
            <StackPanel Orientation="Horizontal">
              <Ellipse x:Name="LinkDot" Width="8" Height="8" VerticalAlignment="Center" />
              <StackPanel Margin="10,0,0,0">
                <TextBlock Style="{StaticResource Text.Base}" Text="{Binding LinkStatusTitle}" FontSize="13" FontWeight="Medium" />
                <TextBlock Style="{StaticResource Text.Caption}" Text="{Binding LinkedSince}"
                           Visibility="{Binding LinkedSince, Converter={x:Static views:Converters.NotNullToVisible}}" />
              </StackPanel>
            </StackPanel>
          </Border>
          <Border Style="{StaticResource Card}" Margin="0,16,0,0">
            <StackPanel>
              <TextBlock Style="{StaticResource Text.Secondary}" Text="{l:Loc cli.account_details}" FontSize="13" FontWeight="Medium" />
              <TextBlock Style="{StaticResource Text.Caption}" Text="{Binding DetailsSubtitle}" FontSize="12" Margin="0,4,0,12" />
              <ItemsControl ItemsSource="{Binding Details}" Focusable="False">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Grid Margin="0,0,0,8">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="140" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>
                      <TextBlock Style="{StaticResource Text.Caption}" Text="{Binding Label}" />
                      <TextBlock Grid.Column="1" Style="{StaticResource Text.Body}" Text="{Binding Value}" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock Style="{StaticResource Text.Caption}" Text="{l:Loc cli.sync_instructions}"
                         Visibility="{Binding IsLinked, Converter={x:Static views:Converters.InverseVisible}}" Margin="0,0,0,8" />
              <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <Button Style="{StaticResource PrimaryButton}" Click="OnSync" AutomationProperties.Name="{Binding SyncLabel}">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE895;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <TextBlock Text="{Binding SyncLabel}" />
                  </StackPanel>
                </Button>
                <Button Style="{StaticResource SecondaryButton}" Margin="10,0,0,0" Click="OnRemove" AutomationProperties.Name="{l:Loc common.remove}"
                        Visibility="{Binding IsLinked, Converter={StaticResource Visible}}">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE74D;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center" Margin="0,0,6,0"
                               Foreground="{DynamicResource Status.Critical}" />
                    <TextBlock Text="{l:Loc common.remove}" Foreground="{DynamicResource Status.Critical}" />
                  </StackPanel>
                </Button>
              </StackPanel>
            </StackPanel>
          </Border>
          <Border Style="{StaticResource Card}" Margin="0,16,0,0">
            <StackPanel>
              <StackPanel Orientation="Horizontal">
                <TextBlock Style="{StaticResource Text.Icon}" Text="&#xE946;" Foreground="{DynamicResource Status.Info}" FontSize="12" />
                <TextBlock Style="{StaticResource Text.Base}" Text="{l:Loc cli.about_title}" FontSize="12" FontWeight="Medium" Margin="8,0,0,0" />
              </StackPanel>
              <TextBlock Style="{StaticResource Text.Caption}" Text="{l:Loc windows.cli.about}" Margin="0,8,0,0" />
            </StackPanel>
          </Border>
        </StackPanel>

        <!-- Appearance -->
        <StackPanel x:Name="PageAppearance">
          <TextBlock Style="{StaticResource Text.PageTitle}" Text="{l:Loc windows.appearance.title}" />
          <TextBlock Style="{StaticResource Text.PageSubtitle}" Text="{l:Loc windows.appearance.subtitle}" />
          <TextBlock Style="{StaticResource Text.Caption}" Text="{l:Loc windows.settings.no_profile}" Margin="0,24,0,0"
                     Visibility="{Binding HasProfile, Converter={x:Static views:Converters.InverseVisible}}" />
          <StackPanel IsEnabled="{Binding HasProfile}">
            <Border Style="{StaticResource Card}" Margin="0,24,0,0">
              <StackPanel>
                <TextBlock Style="{StaticResource Text.Secondary}" Text="{l:Loc appearance.global_settings}" FontSize="13" FontWeight="Medium" />
                <TextBlock Style="{StaticResource Text.Caption}" Text="{l:Loc windows.appearance.global_subtitle}" FontSize="12" Margin="0,4,0,16" />
                <views:SettingToggle Title="{l:Loc appearance.monochrome_title}" Description="{l:Loc appearance.monochrome_description}" IsOn="{Binding Monochrome, Mode=TwoWay}" />
                <views:SettingToggle Title="{l:Loc appearance.show_labels_title}" Description="{l:Loc windows.appearance.show_labels_description}" IsOn="{Binding ShowIconNames, Mode=TwoWay}" />
                <views:SettingToggle Title="{l:Loc appearance.show_remaining_title}" Description="{l:Loc windows.appearance.show_remaining_description}" IsOn="{Binding ShowRemaining, Mode=TwoWay}" />
                <views:SettingToggle Title="{l:Loc appearance.show_time_marker_title}" Description="{l:Loc appearance.show_time_marker_description}" IsOn="{Binding ShowTimeMarker, Mode=TwoWay}" />
                <views:SettingToggle Title="{l:Loc appearance.show_pace_marker_title}" Description="{l:Loc appearance.show_pace_marker_description}" IsOn="{Binding ShowPaceMarker, Mode=TwoWay}" />
                <views:SettingToggle Title="{l:Loc appearance.pace_coloring_title}" Description="{l:Loc appearance.pace_coloring_description}" IsOn="{Binding UsePaceColoring, Mode=TwoWay}" />
              </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
              <StackPanel>
                <TextBlock Style="{StaticResource Text.Secondary}" Text="{l:Loc windows.appearance.metrics}" FontSize="13" FontWeight="Medium" />
                <TextBlock Style="{StaticResource Text.Caption}" Text="{l:Loc windows.appearance.metrics_subtitle}" FontSize="12" Margin="0,4,0,12" />
                <Border Background="{DynamicResource Banner.Info}" CornerRadius="8" Padding="8" Margin="0,0,0,8"
                        Visibility="{Binding AllMetricsOff, Converter={StaticResource Visible}}">
                  <StackPanel>
                    <TextBlock Style="{StaticResource Text.Base}" Text="{l:Loc appearance.all_metrics_off_title}" FontSize="11" FontWeight="SemiBold" />
                    <TextBlock Style="{StaticResource Text.Caption}" Text="{l:Loc windows.appearance.all_metrics_off}" FontSize="10" />
                  </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Padding="12" Margin="0,0,0,8">
                  <StackPanel>
                    <Grid>
                      <StackPanel>
                        <TextBlock Style="{StaticResource Text.Base}" Text="{l:Loc windows.metric.session}" FontSize="13" FontWeight="Medium" />
                        <TextBlock Style="{StaticResource Text.Caption}" Text="{l:Loc windows.metric.session_description}" FontSize="10" />
                      </StackPanel>
                      <CheckBox Style="{StaticResource Switch}" HorizontalAlignment="Right" IsChecked="{Binding SessionEnabled, Mode=TwoWay}"
                                AutomationProperties.Name="{l:Loc windows.metric.session}" />
                    </Grid>
                    <StackPanel Visibility="{Binding SessionEnabled, Converter={StaticResource Visible}}" Margin="0,10,0,0">
                      <TextBlock Style="{StaticResource Text.Caption}" Text="{l:Loc ui.icon_style}" FontWeight="Medium" Margin="0,0,0,6" />
                      <ListBox Style="{StaticResource StylePicker}" ItemsSource="{Binding IconStyles}" SelectedItem="{Binding SessionStyle, Mode=TwoWay}"
                               AutomationProperties.Name="{l:Loc ui.icon_style}" />
                    </StackPanel>
                  </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Padding="12">
                  <StackPanel>
                    <Grid>
                      <StackPanel>
                        <TextBlock Style="{StaticResource Text.Base}" Text="{l:Loc windows.metric.week}" FontSize="13" FontWeight="Medium" />
                        <TextBlock Style="{StaticResource Text.Caption}" Text="{l:Loc windows.metric.week_description}" FontSize="10" />
                      </StackPanel>
                      <CheckBox Style="{StaticResource Switch}" HorizontalAlignment="Right" IsChecked="{Binding WeekEnabled, Mode=TwoWay}"
                                AutomationProperties.Name="{l:Loc windows.metric.week}" />
                    </Grid>
                    <StackPanel Visibility="{Binding WeekEnabled, Converter={StaticResource Visible}}" Margin="0,10,0,0">
                      <TextBlock Style="{StaticResource Text.Caption}" Text="{l:Loc ui.icon_style}" FontWeight="Medium" Margin="0,0,0,6" />
                      <ListBox Style="{StaticResource StylePicker}" ItemsSource="{Binding IconStyles}" SelectedItem="{Binding WeekStyle, Mode=TwoWay}"
                               AutomationProperties.Name="{l:Loc ui.icon_style}" />
                    </StackPanel>
                  </StackPanel>
                </Border>
                <TextBlock Style="{StaticResource Text.Caption}" Text="{l:Loc windows.appearance.square_note}" Margin="0,10,0,0" />
              </StackPanel>
            </Border>
          </StackPanel>
        </StackPanel>

        <!-- General -->
        <StackPanel x:Name="PageGeneral">
          <TextBlock Style="{StaticResource Text.PageTitle}" Text="{l:Loc general.title}" />
          <TextBlock Style="{StaticResource Text.PageSubtitle}" Text="{l:Loc windows.general.subtitle}" />
          <TextBlock Style="{StaticResource Text.Caption}" Text="{l:Loc windows.settings.no_profile}" Margin="0,24,0,0"
                     Visibility="{Binding HasProfile, Converter={x:Static views:Converters.InverseVisible}}" />
          <Border Style="{StaticResource Card}" Margin="0,24,0,0" IsEnabled="{Binding HasProfile}">
            <StackPanel>
              <TextBlock Style="{StaticResource Text.Secondary}" Text="{l:Loc general.refresh_title}" FontSize="13" FontWeight="Medium" />
              <TextBlock Style="{StaticResource Text.Caption}" Text="{l:Loc general.refresh_subtitle}" FontSize="12" Margin="0,4,0,16" />
              <StackPanel Orientation="Horizontal">
                <TextBlock Style="{StaticResource Text.Icon}" Text="&#xE917;" FontSize="14" Foreground="{DynamicResource Accent}" Width="20" />
                <TextBlock Style="{StaticResource Text.Base}" Text="{Binding RefreshText}" FontSize="13" FontWeight="Medium" Margin="10,0,0,0" />
              </StackPanel>
              <Slider Minimum="10" Maximum="300" TickFrequency="10" IsSnapToTickEnabled="True" SmallChange="10" LargeChange="30"
                      Value="{Binding RefreshInterval, Mode=TwoWay}" Margin="0,12,0,0"
                      AutomationProperties.Name="{l:Loc general.refresh_title}" />
              <Grid>
                <TextBlock Style="{StaticResource Text.Caption}" Text="{l:Loc general.refresh_min}" />
                <TextBlock Style="{StaticResource Text.Caption}" Text="{l:Loc general.refresh_max}" HorizontalAlignment="Right" />
              </Grid>
            </StackPanel>
          </Border>
        </StackPanel>

        <!-- Popover -->
        <StackPanel x:Name="PagePopover">
          <TextBlock Style="{StaticResource Text.PageTitle}" Text="{l:Loc popover.title}" />
          <TextBlock Style="{StaticResource Text.PageSubtitle}" Text="{l:Loc popover.subtitle}" />
          <Border Style="{StaticResource Card}" Margin="0,24,0,0">
            <StackPanel>
              <TextBlock Style="{StaticResource Text.Secondary}" Text="{l:Loc popover.time_display}" FontSize="13" FontWeight="Medium" />
              <TextBlock Style="{StaticResource Text.Caption}" Text="{l:Loc popover.time_display_desc}" FontSize="12" Margin="0,4,0,12" />
              <Border Background="{DynamicResource Track}" CornerRadius="6" Padding="2" HorizontalAlignment="Left">
                <StackPanel Orientation="Horizontal">
                  <RadioButton Style="{StaticResource Segment}" GroupName="TimeDisplay" Content="{l:Loc popover.time_display_reset}" IsChecked="{Binding TimeDisplayReset, Mode=TwoWay}" />
                  <RadioButton Style="{StaticResource Segment}" GroupName="TimeDisplay" Content="{l:Loc popover.time_display_remaining}" IsChecked="{Binding TimeDisplayRemaining, Mode=TwoWay}" />
                  <RadioButton Style="{StaticResource Segment}" GroupName="TimeDisplay" Content="{l:Loc popover.time_display_both}" IsChecked="{Binding TimeDisplayBoth, Mode=TwoWay}" />
                </StackPanel>
              </Border>
            </StackPanel>
          </Border>
          <Border Style="{StaticResource Card}" Margin="0,16,0,0">
            <StackPanel>
              <TextBlock Style="{StaticResource Text.Secondary}" Text="{l:Loc popover.time_format}" FontSize="13" FontWeight="Medium" />
              <TextBlock Style="{StaticResource Text.Caption}" Text="{l:Loc popover.time_format_desc}" FontSize="12" Margin="0,4,0,12" />
              <Border Background="{DynamicResource Track}" CornerRadius="6" Padding="2" HorizontalAlignment="Left">
                <StackPanel Orientation="Horizontal">
                  <RadioButton Style="{StaticResource Segment}" GroupName="TimeFormat" Content="{l:Loc popover.time_format_system}" IsChecked="{Binding TimeFormatSystem, Mode=TwoWay}" />
                  <RadioButton Style="{StaticResource Segment}" GroupName="TimeFormat" Content="{l:Loc popover.time_format_12h}" IsChecked="{Binding TimeFormat12, Mode=TwoWay}" />
                  <RadioButton Style="{StaticResource Segment}" GroupName="TimeFormat" Content="{l:Loc popover.time_format_24h}" IsChecked="{Binding TimeFormat24, Mode=TwoWay}" />
                </StackPanel>
              </Border>
            </StackPanel>
          </Border>
        </StackPanel>

        <!-- About -->
        <StackPanel x:Name="PageAbout" HorizontalAlignment="Center" Margin="8">
          <Grid Width="64" Height="64" Margin="0,16,0,0">
            <Ellipse Stroke="{DynamicResource Accent}" StrokeThickness="6" />
            <Ellipse Width="14" Height="14" Fill="{DynamicResource Accent}" />
          </Grid>
          <TextBlock Style="{StaticResource Text.Base}" Text="{l:Loc app.name}" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,12,0,0" />
          <TextBlock Style="{StaticResource Text.Secondary}" Text="{l:Loc windows.about.subtitle}" FontSize="12" HorizontalAlignment="Center" />
          <TextBlock Style="{StaticResource Text.Secondary}" Text="{Binding Version}" FontSize="11" HorizontalAlignment="Center" Margin="0,4,0,0" />
          <TextBlock Style="{StaticResource Text.Caption}" Text="{l:Loc windows.about.port_note}" TextAlignment="Center" MaxWidth="400" Margin="0,16,0,0" />
          <Rectangle Height="1" Margin="0,20" Fill="{DynamicResource Line.Divider}" />
          <TextBlock Style="{StaticResource Text.Base}" Text="{l:Loc about.links}" FontSize="13" FontWeight="Medium" />
          <StackPanel Margin="0,8,0,0" Width="320">
            <Button Style="{StaticResource PlainButton}" Padding="4,4" Click="OnLink" Tag="https://github.com/hamed-elfayome/Claude-Usage-Tracker" HorizontalContentAlignment="Stretch"
                    AutomationProperties.Name="{l:Loc windows.about.original}">
              <DockPanel>
                <TextBlock DockPanel.Dock="Right" Style="{StaticResource Text.Icon}" Text="&#xE8A7;" FontSize="9" />
                <TextBlock Style="{StaticResource Text.Base}" Text="{l:Loc windows.about.original}" FontSize="12" />
              </DockPanel>
            </Button>
            <Button Style="{StaticResource PlainButton}" Padding="4,4" Click="OnLink" Tag="https://github.com/harningle/claude-usage-tracker" HorizontalContentAlignment="Stretch"
                    AutomationProperties.Name="{l:Loc windows.about.port_repo}">
              <DockPanel>
                <TextBlock DockPanel.Dock="Right" Style="{StaticResource Text.Icon}" Text="&#xE8A7;" FontSize="9" />
                <TextBlock Style="{StaticResource Text.Base}" Text="{l:Loc windows.about.port_repo}" FontSize="12" />
              </DockPanel>
            </Button>
            <Button Style="{StaticResource PlainButton}" Padding="4,4" Click="OnLink" Tag="https://github.com/harningle/claude-usage-tracker/issues" HorizontalContentAlignment="Stretch"
                    AutomationProperties.Name="{l:Loc about.report_issue}">
              <DockPanel>
                <TextBlock DockPanel.Dock="Right" Style="{StaticResource Text.Icon}" Text="&#xE8A7;" FontSize="9" />
                <TextBlock Style="{StaticResource Text.Base}" Text="{l:Loc about.report_issue}" FontSize="12" />
              </DockPanel>
            </Button>
            <Rectangle Height="1" Margin="0,8" Fill="{DynamicResource Line.Divider}" />
            <Button Style="{StaticResource PlainButton}" Padding="4,4" Click="OnRunWizard" HorizontalContentAlignment="Stretch"
                    AutomationProperties.Name="{l:Loc about.run_setup_wizard}">
              <TextBlock Style="{StaticResource Text.Base}" Text="{l:Loc about.run_setup_wizard}" FontSize="12" />
            </Button>
          </StackPanel>
          <TextBlock Style="{StaticResource Text.Secondary}" Text="{l:Loc about.mit_license}" FontSize="11" HorizontalAlignment="Center" Margin="0,24,0,0" />
          <TextBlock Style="{StaticResource Text.Secondary}" Text="{l:Loc windows.about.copyright}" FontSize="11" HorizontalAlignment="Center" />
        </StackPanel>
      </Grid>
    </ScrollViewer>
  </Grid>
</Window>
