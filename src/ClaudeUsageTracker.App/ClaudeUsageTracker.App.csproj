<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Versioned Windows target: required by the Windows App SDK notifications. The Windows App SDK is
    self-contained and unpackaged (plan.md section 2), which needs a runtime identifier.
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
  </PropertyGroup>

  <!--
    dotnet publish makes the personal build (Milestone 6): .NET is self-contained too, so the published folder
    needs no installed runtime. Builds stay framework-dependent, because the test project cannot reference a
    self-contained executable.
  -->
  <PropertyGroup Condition="'$(_IsPublishing)' == 'true'">
    <SelfContained>true</SelfContained>
  </PropertyGroup>

  <!--
    The port is English only (accepted 2026-10-05), so the frameworks' own text, such as a text box's context
    menu, stays English too. Leaving out their 13 other languages saves 156 files and 8.7 MB of the published build.
  -->
  <PropertyGroup>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ClaudeUsageTracker.Core\ClaudeUsageTracker.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ClaudeUsageTracker.Tests" />
  </ItemGroup>

  <!--
    claude.ai sign-in and requests go through per-profile WebView2 contexts (plan.md section 2). The
    version is the one the Milestone 1 spike measured.
  -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4258.31" />
  </ItemGroup>

  <!--
    Local notifications through AppNotificationManager, as the Milestone 1 spike verified. Only the
    Foundation package: no Singleton (push) package. PrivateAssets keeps it out of the test project, which
    never posts notifications (its own Windows App SDK auto-initialisers would otherwise run in the test host).
    PrivateAssets alone would also leave them out of a publish, whose app then fails at start for want of the
    projection assemblies (Milestone 6), so Publish puts them back.
  -->
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK.Foundation" Version="2.3.12" PrivateAssets="all" Publish="true" />
    <!-- Foundation 2.3.12 asks for 2.1.8, which nuget.org does not list; pinning the version it resolves to keeps restore warning-free. -->
    <PackageReference Include="Microsoft.WindowsAppSDK.InteractiveExperiences" Version="2.1.9" PrivateAssets="all" Publish="true" />
    <!-- Only for the MSIX below; its build assets are not imported. Version paired by the 2.5.1 metapackage. -->
    <PackageReference Include="Microsoft.WindowsAppSDK.Runtime" Version="2.5.1" ExcludeAssets="all" PrivateAssets="all" GeneratePathProperty="true" />
  </ItemGroup>

  <!--
    Self-contained Windows App SDK 2.5.1 output lacks Microsoft.WindowsAppRuntime.Insights.Resource.dll (it
    exists only inside the runtime MSIX), and AppNotificationManager.Register() then throws "Unable to load
    resource dll" (Milestone 1, D5). Extract that one file next to the executable. Check again on every
    Windows App SDK update whether the package ships it.
  -->
  <PropertyGroup>
    <InsightsMsix>$(PkgMicrosoft_WindowsAppSDK_Runtime)\tools\MSIX\win10-x64\Microsoft.WindowsAppRuntime.2.msix</InsightsMsix>
  </PropertyGroup>
  <Target Name="ExtractInsightsResourceAfterBuild" AfterTargets="Build">
    <Unzip SourceFiles="$(InsightsMsix)" DestinationFolder="$(OutDir)" Include="Microsoft.WindowsAppRuntime.Insights.Resource.dll" />
  </Target>
  <Target Name="ExtractInsightsResourceAfterPublish" AfterTargets="Publish">
    <Unzip SourceFiles="$(InsightsMsix)" DestinationFolder="$(PublishDir)" Include="Microsoft.WindowsAppRuntime.Insights.Resource.dll" />
  </Target>

  <!--
    The NativeAOT helper the app installs for the status line and the launchers (plan.md section 2). For a build
    it is published on its own (dotnet publish src/ClaudeUsageTracker.Helper -c Release -r win-x64), because
    NativeAOT needs the C++ build tools and takes far longer than a build. When that output exists it is copied to
    helper\ beside the app, where the app looks for it; without it the app says that this build has no helper.
    Publishing the app publishes the helper first, so a personal build always carries a current one: the helper's
    version number alone would not show that a copy published from an older checkout is out of date.
  -->
  <PropertyGroup>
    <HelperProject>$(MSBuildThisFileDirectory)..\ClaudeUsageTracker.Helper\ClaudeUsageTracker.Helper.csproj</HelperProject>
    <PublishedHelper>$(ArtifactsPath)\publish\ClaudeUsageTracker.Helper\release_win-x64\ClaudeUsageTracker.Helper.exe</PublishedHelper>
  </PropertyGroup>
  <Target Name="CopyHelperAfterBuild" AfterTargets="Build" Condition="Exists('$(PublishedHelper)')">
    <Copy SourceFiles="$(PublishedHelper)" DestinationFolder="$(OutDir)helper" SkipUnchangedFiles="true" />
  </Target>
  <Target Name="PublishHelperBeforePublish" BeforeTargets="PrepareForPublish">
    <Exec Command="dotnet publish &quot;$(HelperProject)&quot; -c Release -r win-x64 &quot;-p:ArtifactsPath=$(ArtifactsPath)&quot;" />
  </Target>
  <Target Name="CopyHelperAfterPublish" AfterTargets="Publish">
    <Copy SourceFiles="$(PublishedHelper)" DestinationFolder="$(PublishDir)helper" />
  </Target>

  <!--
    Upstream's Localizable.strings files, unchanged and looked up by upstream key, plus Windows.strings
    for text the port adds (keys prefixed "windows.").
  -->
  <ItemGroup>
    <EmbeddedResource Include="Resources\Localisation\**\*.strings"
                      LogicalName="Localisation.%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
