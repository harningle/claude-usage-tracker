<Project Sdk="Microsoft.NET.Sdk">

  <!--
    A stand-in for the native claude.exe, for tests of the launcher only: it records the arguments and the
    folder it was started with, and waits for console interruptions when asked to. It contacts nothing.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>claude</AssemblyName>
    <RootNamespace>FakeClaude</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

</Project>
