<Project Sdk="Microsoft.NET.Sdk">

  <!--
    A stand-in for codex.exe, for tests of the Codex auto-start only: it records what it was started with and prints
    the events of codex exec as told. It contacts nothing.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>codex</AssemblyName>
    <RootNamespace>FakeCodex</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

</Project>
