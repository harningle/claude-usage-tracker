<Project Sdk="Microsoft.NET.Sdk">

  <!-- Same versioned Windows target as App so this project can reference it. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.10.0" />
    <PackageReference Include="xunit.v3" Version="4.0.1" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\ClaudeUsageTracker.Core\ClaudeUsageTracker.Core.csproj" />
    <ProjectReference Include="..\..\src\ClaudeUsageTracker.App\ClaudeUsageTracker.App.csproj" />
    <!-- Built before the tests, which run them as child processes; they are not referenced as assemblies. -->
    <ProjectReference Include="..\FakeClaude\FakeClaude.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\FakeCodex\FakeCodex.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

</Project>
